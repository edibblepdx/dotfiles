alias v='vim'
alias n='nvim'
alias ls='ls --color=auto'
alias ll='ls -lrta'
alias la='ls -a'
alias hd='hexdump -C'
alias psu='ssh edibble@babbage.cs.pdx.edu'
alias yazi='~/Clones/yazi/target/release/yazi'
alias vims='vim -S'
alias vall='valgrind --leak-check=full \
                     --show-leak-kinds=all \
                     --track-origins=yes \
                     --verbose \
                     --log-file=valgrind-out.txt'

# useful with --stat or --patch or -p
alias gl='git log --oneline --decorate --graph --all'
alias gla='git log --pretty=format:"%h - %an, %ar : %s" --graph --all'
alias gbv='git fetch --all; git branch -vv'

# terraform
alias tf='terraform'

# django
alias dj='python manage.py'
