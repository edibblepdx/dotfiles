snippet sin "system include" b
#include <$1>
$0
endsnippet

snippet uin "user include" b
#include "$1"
$0
endsnippet

snippet fun "function c++" b
${1:return type} ${2:name} (${3:params})${4: : initialization list}
{
	$0
}
endsnippet

snippet class "class c++" b
class ${1:name}${2: : access-specifier base_class} {
	${3:public:
}
	${4:private:
}
	${5:protected:
}
}$6;
$0
endsnippet

snippet struct "structure" b
struct ${1:name} {
	$2
}$3;
$0
endsnippet


snippet { "environment c++" b
{$1}
$0
endsnippet



